      <!ELEMENT Lung(#PCDATA)>
      <!ELEMENT Lung_spalla(#PCDATA)>
      <!ELEMENT Lung_manica(#PCDATA)>
      <!ELEMENT Lung_gamba(#PCDATA)> 
      <!ELEMENT Cavallo(#PCDATA)>
      <!ELEMENT Larg_spalla(#PCDATA)> 
    
     <!ELEMENT Info_account(Account_liv, Account_exp, Account_crediti)>
       <!ELEMENT Account_liv(#PCDATA)>
